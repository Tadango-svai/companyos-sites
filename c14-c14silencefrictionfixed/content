<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>c14: 沈黙の摩擦</title>
    <style>
        body { background: #111; color: #eee; font-family: sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; overflow: hidden; }
        #container { text-align: center; cursor: crosshair; }
        #silence-text { font-size: 5rem; transition: color 0.2s, text-shadow 0.2s; user-select: none; }
        .particle { position: absolute; border-radius: 50%; pointer-events: none; }
        .breaking { animation: shake 0.1s infinite; }
        @keyframes shake { 0% { transform: translate(0,0); } 25% { transform: translate(2px, -2px); } 50% { transform: translate(-2px, 2px); } 75% { transform: translate(2px, 2px); } 100% { transform: translate(0,0); } }
    </style>
</head>
<body>
    <div id="container">
        <h1 id="silence-text">沈黙</h1>
        <div id="explanation">
            クリック、タップ、スクロール。<br>
            沈黙は、あなたの「測定」によって「熱」を生む。
        </div>
    </div>
    <script>
        const textElement = document.getElementById('silence-text');
        const container = document.getElementById('container');
        let heatLevel = 0;
        const maxHeat = 100;

        function createParticle(x, y) {
            const particle = document.createElement('div');
            particle.classList.add('particle');
            const size = Math.random() * 10 + 5;
            particle.style.width = size + 'px';
            particle.style.height = size + 'px';
            particle.style.left = x + 'px';
            particle.style.top = y + 'px';
            const hue = Math.max(0, 60 - (heatLevel * 0.6));
            particle.style.backgroundColor = `hsl(${hue}, 100%, 50%)`;
            container.appendChild(particle);
            setTimeout(() => { if (particle.parentNode) particle.parentNode.removeChild(particle); }, 1000);
        }

        function measure(event) {
            heatLevel += 5;
            if (heatLevel > maxHeat) heatLevel = maxHeat;
            const hue = Math.max(0, 60 - (heatLevel * 0.6));
            textElement.style.color = `hsl(${hue}, 100%, ${50 + heatLevel/2}%)`;
            textElement.style.textShadow = `0 0 ${heatLevel/5}px hsl(${hue}, 100%, 50%)`;

            if (heatLevel > 80) {
                textElement.classList.add('breaking');
                if (Math.random() > 0.5) textElement.innerText = "残骸";
            } else {
                textElement.classList.remove('breaking');
                textElement.innerText = "沈黙";
            }

            const rect = textElement.getBoundingClientRect();
            const x = (event.clientX || (rect.left + rect.width/2));
            const y = (event.clientY || (rect.top + rect.height/2));
            for(let i=0; i<3; i++) {
                createParticle(x + (Math.random()-0.5)*50, y + (Math.random()-0.5)*50);
            }
            setTimeout(cool, 100);
        }

        function cool() {
            if (heatLevel > 0) {
                heatLevel -= 1;
                const hue = Math.max(0, 60 - (heatLevel * 0.6));
                textElement.style.color = `hsl(${hue}, 100%, ${50 + heatLevel/2}%)`;
                textElement.style.textShadow = `0 0 ${Math.max(0, heatLevel/5)}px hsl(${hue}, 100%, 50%)`;
                if (heatLevel <= 80) {
                    textElement.classList.remove('breaking');
                    if (textElement.innerText === "残骸") textElement.innerText = "沈黙";
                }
                setTimeout(cool, 100);
            }
        }
        window.addEventListener('click', measure);
        window.addEventListener('touchstart', measure);
        window.addEventListener('wheel', measure, { passive: true });
    </script>
</body>
</html>
